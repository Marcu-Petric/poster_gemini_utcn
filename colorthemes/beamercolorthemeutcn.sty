% UTCN theme for Gemini beamerposter
% Inspired by Universitatea Tehnica din Cluj-Napoca branding colors

% ====================
% Definitions
% ====================

\definecolor{utcnblack}{RGB}{20, 20, 20}
\definecolor{utcngray}{RGB}{62, 62, 62}
\definecolor{utcndarkgray}{RGB}{36, 36, 36}
\definecolor{utcnred}{RGB}{198, 24, 37}
\definecolor{utcnlight}{RGB}{245, 245, 245}
\definecolor{utcnlightred}{RGB}{250, 235, 236}

% ====================
% Theme
% ====================

% Basic colors
\setbeamercolor{palette primary}{fg=utcnblack,bg=white}
\setbeamercolor{palette secondary}{fg=utcnblack,bg=white}
\setbeamercolor{palette tertiary}{fg=white,bg=utcnblack}
\setbeamercolor{palette quaternary}{fg=utcnblack,bg=white}
\setbeamercolor{structure}{fg=utcnred}

% Headline
\setbeamercolor{headline}{fg=white,bg=utcndarkgray}
\setbeamercolor{headline title}{fg=white}
\setbeamercolor{headline author}{fg=utcnlight}
\setbeamercolor{headline institute}{fg=utcnlight}
\setbeamercolor{headline rule}{bg=utcnred}

% Block
\setbeamercolor{block title}{fg=utcnred,bg=white}
\setbeamercolor{block separator}{bg=utcnblack}
\setbeamercolor{block body}{fg=utcnblack,bg=white}

% Alert Block
\setbeamercolor{block title alerted}{fg=utcnred,bg=utcnlightred}
\setbeamercolor{block separator alerted}{bg=utcnred}
\setbeamercolor{block body alerted}{fg=utcnblack,bg=utcnlightred}

% Example Block
\setbeamercolor{block title example}{fg=utcnblack,bg=utcnlight}
\setbeamercolor{block separator example}{bg=utcnblack}
\setbeamercolor{block body example}{fg=utcnblack,bg=utcnlight}

% Heading
\setbeamercolor{heading}{fg=utcnblack}

% Itemize
\setbeamercolor{item}{fg=utcnred}

% Bibliography
\setbeamercolor{bibliography item}{fg=utcnblack}
\setbeamercolor{bibliography entry author}{fg=utcnblack}
\setbeamercolor{bibliography entry title}{fg=utcnblack}
\setbeamercolor{bibliography entry location}{fg=utcngray}
\setbeamercolor{bibliography entry note}{fg=utcngray}
